{
  "name": "better-calendar",
  "private": true,
  "description": "Google Calendar as a list of photo cards. Static site (no build step) with Firebase sync.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node tests/serve.mjs 8000",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-timeout=5000 \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "photos:fetch": "node tools/curate-photos/fetch.mjs",
    "photos:build": "node tools/curate-photos/build.mjs",
    "bench": "node tests/e2e/perf.bench.mjs"
  }
}
