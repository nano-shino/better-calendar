# Settings for server.mjs (self-hosted token server). install-linux.sh copies
# this to /etc/better-calendar-tokens.env and fills in TOKEN_KEY.
# Keep the real file private: it holds the client secret and the encryption key.

# The OAuth Web client's secret (Google Cloud > Credentials > Web client).
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Changing it makes every stored token unreadable.
TOKEN_KEY=

GOOGLE_CLIENT_ID=1030565348689-ccj4fbrm4bqdekbguq5ofm31ur8s04a0.apps.googleusercontent.com
FIREBASE_PROJECT_ID=better-calendar-dc33f
FIREBASE_API_KEY=AIzaSyA_nJLcW9S4apod2AwrRURx1On1XWNVBOI
ALLOWED_ORIGINS=https://nano-shino.github.io,http://localhost:8000

# Where it listens. Keep 127.0.0.1 and put an HTTPS proxy in front (docs/SETUP.md).
PORT=8787
HOST=127.0.0.1
